{
  "name": "@verikit-examples/waitlist-sqlite",
  "version": "0.25.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch-path=server --watch-path=resources --watch-path=actions --watch-path=db server/dev.ts",
    "build": "vite build",
    "start": "node server/index.ts",
    "typecheck": "verikit generate:schema --check && tsc",
    "db:generate": "verikit generate:schema && drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "node --test \"test/**/*.test.ts\"",
    "smoke": "verikit generate:schema --check && tsc && node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@tanstack/react-query": "^5.101.4",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "verikit": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "drizzle-kit": "^0.31.0",
    "shadcn": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0"
  },
  "description": "Example Verikit app: a waitlist anyone can join and an admin manages."
}
