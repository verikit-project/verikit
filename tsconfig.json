{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.ts", "script/**/*.ts"],
  "exclude": ["**/dist", "**/node_modules"],
  "references": [
    {
      "path": "./packages/core"
    }
  ]
}
