{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/*/src/**/*.ts"],
  "exclude": ["**/dist", "**/node_modules"],
  "references": [
    {
      "path": "./packages/core"
    },
    {
      "path": "./packages/runtime"
    },
    {
      "path": "./packages/ui/react"
    }
  ]
}
