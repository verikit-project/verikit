{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "tsBuildInfoFile": ".test-dist/tsconfig.test.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"],
  "exclude": ["dist", ".test-dist", "node_modules"]
}
