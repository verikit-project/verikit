{
  "name": "@verikit/react",
  "version": "0.19.0",
  "description": "React UI bindings for Verikit resource workflows.",
  "type": "module",
  "main": "./dist/index.js",
  "keywords": [
    "typescript",
    "resource",
    "schema",
    "resource-model",
    "metadata",
    "builder",
    "validation",
    "framework"
  ],
  "author": "Chidi E <hi@ceeso.dev>",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    }
  },
  "imports": {
    "#components/*": {
      "types": "./src/components/*.tsx",
      "default": "./dist/components/*.js"
    },
    "#lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "pnpm clean && tsc -b",
    "prepack": "pnpm build",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test $(find ./.test-dist/test -name '*.test.js' -type f | sort)",
    "test:coverage": "rm -rf .test-dist coverage && tsc -p tsconfig.test.json && node --test --experimental-test-coverage --test-coverage-include='.test-dist/src/**/*.js' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 $(find ./.test-dist/test -name '*.test.js' -type f | sort)"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@verikit/client": "workspace:*",
    "@verikit/core": "workspace:*",
    "@verikit/runtime": "workspace:*",
    "@verikit/theme": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
