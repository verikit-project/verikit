{
  "name": "verikit",
  "version": "0.4.6",
  "private": true,
  "description": "A TypeScript resource framework.",
  "scripts": {
    "prepack": "node -e \"console.error('Workspace root is private; publish @verikit/core instead.'); process.exit(1)\"",
    "vsync": "node script/sync-version.js",
    "build": "pnpm --filter @verikit/core build",
    "test": "pnpm --filter @verikit/core test",
    "test:coverage": "pnpm --filter @verikit/core test:coverage",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "keywords": [
    "typescript",
    "resource",
    "schema",
    "resource-model",
    "metadata",
    "builder",
    "validation",
    "framework"
  ],
  "author": "Chidi E <hi@ceeso.dev>",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.12.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
