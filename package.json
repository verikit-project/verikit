    "vsync": "pnpm exec tsx script/sync-version.ts",
    "test": "pnpm --filter @verikit/core test",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
